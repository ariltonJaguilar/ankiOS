    "Subpastas dentro da pasta de mídia não são suportadas pelo Anki." : {
      "localizations" : {
        "ar-SA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المجلدات داخل مجلد الوسائط غير مدعومة."
          }
        },
        "be-BY" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Папкі ў папцы для медыя не падтрымліваюцца"
          }
        },
        "ca-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anki no és compatible amb la creació de subcarpetes dins de la carpeta de fitxers multimèdia."
          }
        },
        "cs-CZ" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Složky uvnitř složky s multimédii nejsou podporovány."
          }
        },
        "da-DK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapper inde i media-mapper er ikke understøttet."
          }
        },
        "de-DE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner innerhalb des Medienordners werden nicht unterstützt."
          }
        },
        "el-GR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Φάκελοι μέσα στον φάκελο των πολυμέσων δεν υποστηρίζονται."
